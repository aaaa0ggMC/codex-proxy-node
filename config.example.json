{
  "default_provider": "codex",
  "providers": [
    {
      "name": "codex",
      "type": "codex",
      "enabled": true,
      "comment": "No key: this uses the ChatGPT login in auth.json. Point codex_home elsewhere to use a second account."
    },
    {
      "name": "deepseek",
      "type": "openai-responses",
      "enabled": true,
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "reasoning_effort": "low"
    },
    {
      "name": "deepseek",
      "type": "openai-responses",
      "enabled": false,
      "base_url": "https://api.deepseek.com/v1",
      "api_key": "sk-second-account",
      "comment": "Same name as the entry above: requests to deepseek/* fall over to this one, so two keys can back one namespace."
    },
    {
      "name": "stepfun",
      "type": "openai",
      "enabled": false,
      "base_url": "https://api.stepfun.ai/step_plan/v1",
      "api_key_env": "STEPFUN_API_KEY",
      "model": "step-3.7-flash",
      "reasoning_effort": "low"
    },
    {
      "name": "local",
      "type": "openai-responses",
      "enabled": false,
      "base_url": "http://127.0.0.1:8080/v1",
      "models": ["my-local-model"]
    }
  ]
}
